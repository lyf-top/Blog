---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import ArchiveHeatmap from "@components/widget/ArchiveHeatmap.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { PageHeader } from "@/components/features/page-header";
import { getSortedPostsList } from "@/utils/content-utils";

const sortedPostsList = await getSortedPostsList();
const title = i18n(I18nKey.archive);
---

<MainGridLayout title={title}>
	<!-- 分类/标签筛选时同步 Banner 标题 -->
	<script is:inline>
		(function () {
			var p = new URLSearchParams(location.search);
			var cat = p.get("category") || "";
			var tag = p.get("tag") || "";
			var unc = p.get("uncategorized");
			var t = cat || (unc ? "未分类" : "") || (tag ? "#" + tag : "");
			if (t) {
				requestAnimationFrame(function () {
					var el = document.querySelector(".banner-page-title-text");
					if (el) el.textContent = t;
				});
			}
		})();
	</script>

	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<PageHeader title={title} />
			<ArchiveHeatmap posts={sortedPostsList} />
			<ArchivePanel />
		</div>
	</div>
</MainGridLayout>
