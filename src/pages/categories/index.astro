---
import CategoryRose from "@components/widget/CategoryRose.astro";
import TagGraph from "@components/widget/TagGraph.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { PageHeader } from "@/components/features/page-header";
import { getCategoryList, getTagGraphData } from "@/utils/content-utils";

const categories = await getCategoryList();
const tagGraph = await getTagGraphData();
const title = i18n(I18nKey.categoriesTagsPage);
const subtitle = i18n(I18nKey.categoriesTagsSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="categories-page card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			<!-- 南丁格尔玫瑰图 -->
			<CategoryRose categories={categories} />

			<!-- 分隔线 -->
			<div class="categories-page__divider"></div>

			<!-- 标签力导向关系图 -->
			<div id="tag-graph-container">
				<TagGraph graph={tagGraph} />
			</div>
		</div>
	</div>
</MainGridLayout>
